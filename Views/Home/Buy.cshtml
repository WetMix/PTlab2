@{
    Layout = null;
}
<!DOCTYPE html>
<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>Покупка</title>
</head>
<body>
    <div>
        <h3>Покупка: @ViewBag.ProductName</h3>
        <p>Цена: @ViewBag.ProductPrice</p>
        <p>В наличии: @ViewBag.ProductQuantity</p>
        <form method="post">
            <input type="hidden" value="@ViewBag.ProductId" name="productId" />
            <table>
                <tr>
                    <td><p>Введите своё имя</p></td>
                    <td><input type="text" name="person" /></td>
                </tr>
                <tr>
                    <td><p>Введите адрес доставки:</p></td>
                    <td><input type="text" name="address" /></td>
                </tr>
                <tr><td><input type="submit" value="Отправить" /></td><td></td></tr>
            </table>
        </form>
    </div>
</body>
</html>
